<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>BDD</groupId>
    <artifactId>APIFramework</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <properties>
        <!-- Language level and target JVM for main and test code; the project needs Java 11+ (logback-classic 1.5+) -->
        <maven.compiler.release>11</maven.compiler.release>
        <!-- Read and write source files as UTF-8 on every machine -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- One version for every Reporting Labs artifact -->
        <reporting-labs.version>0.1.35</reporting-labs.version>
    </properties>

    <dependencies>

        <!-- https://mvnrepository.com/artifact/io.rest-assured/rest-assured -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>5.4.0</version>
        </dependency>

        <!-- https://mvnrepository.com/artifact/io.cucumber/cucumber-java -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>7.17.0</version>
            <scope>test</scope>
        </dependency>

        <!-- https://mvnrepository.com/artifact/io.cucumber/cucumber-junit -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit</artifactId>
            <version>7.17.0</version>
            <scope>test</scope>
        </dependency>

        <!-- https://mvnrepository.com/artifact/com.fasterxml.jackson.core/jackson-databind -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.22.4</version>
        </dependency>

        <!-- https://mvnrepository.com/artifact/ch.qos.logback/logback-classic -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.6.3</version>
        </dependency>

        <!-- https://mvnrepository.com/artifact/io.cucumber/cucumber-picocontainer -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-picocontainer</artifactId>
            <version>7.17.0</version>
            <scope>test</scope>
        </dependency>

        <!-- Reporting Labs: one-file HTML report (target/reporting-labs); plugin registered in TestRunner.
        https://reportinglabs.dev/get-started/java/cucumber -->
        <dependency>
            <groupId>dev.reportinglabs</groupId>
            <artifactId>reporting-labs-cucumber</artifactId>
            <version>${reporting-labs.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Reporting Labs API recording; records every REST Assured call (global filter), masked via reporting-labs.properties -->
        <dependency>
            <groupId>dev.reportinglabs</groupId>
            <artifactId>reporting-labs-rest-assured</artifactId>
            <version>${reporting-labs.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Gherkin parser and its document types, used by the feature-file convention tests. Keep these on the versions
     Cucumber itself uses (mvn dependency:tree "-Dincludes=io.cucumber:gherkin") when Cucumber is upgraded. -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>gherkin</artifactId>
            <version>28.0.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>messages</artifactId>
            <version>24.1.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <testFailureIgnore>true</testFailureIgnore>
                </configuration>
            </plugin>
            <!-- Compiles with maven.compiler.release (needs 3.6+); pinned so every machine builds the same way -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
        </plugins>
    </build>

</project>